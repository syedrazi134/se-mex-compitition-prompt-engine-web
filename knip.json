{
  "$schema": "https://unpkg.com/knip@6.43.0/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", ".claude/hooks/*.mjs"]
    },
    "apps/api": {
      "entry": [
        "src/worker.ts",
        "src/middleware/*.ts",
        "src/lib/*.ts",
        "src/modules/**/*.ts",
        "src/**/*.test.ts",
        "test/**/*.ts"
      ],
      "ignoreDependencies": [
        "@node-rs/argon2",
        "@prompt-engine/oauth-providers"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
