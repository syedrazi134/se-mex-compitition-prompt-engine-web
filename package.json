{
  "name": "prompt-engine",
  "private": true,
  "description": "Prompt Engine shared backend (Phase 1) and future web apps",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/shared-types",
    "packages/ai-adapters",
    "packages/payment-adapters",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run build:packages && npm run dev -w @prompt-engine/api",
    "build:packages": "tsc -b packages/shared-types/tsconfig.build.json packages/ai-adapters/tsconfig.build.json packages/payment-adapters/tsconfig.build.json",
    "build": "npm run build:packages && tsc -p apps/api/tsconfig.build.json",
    "typecheck": "npm run build:packages && tsc -p packages/shared-types --noEmit && tsc -p packages/ai-adapters --noEmit && tsc -p packages/payment-adapters --noEmit && tsc -p apps/api --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "health": "node scripts/health.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify-quick.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "knip": "6.43.0",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
