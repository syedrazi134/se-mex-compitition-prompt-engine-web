# Copy to .env and fill in real values locally. Never commit .env.
# Every variable the API, worker and docker-compose read, with placeholder values only.

# --- API and worker (validated at startup by apps/api/src/config/env.ts) ---
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Must be a replica set: transactions need it. docker-compose.yml starts one named rs0.
MONGODB_URI=mongodb://localhost:27017/prompt_engine?replicaSet=rs0
REDIS_URL=redis://localhost:6379
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
# Comma-separated browser origins allowed by CORS (web app, admin panel).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# --- Local object storage (docker-compose MinIO; not read by the API yet) ---
MINIO_ROOT_USER=local-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-local-password
