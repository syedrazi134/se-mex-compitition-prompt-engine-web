# Browser requests use this base URL. Add the web origin to the backend CORS allow-list.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Server-side auth proxy target; defaults to NEXT_PUBLIC_API_BASE_URL.
API_BASE_URL=http://localhost:3000/api/v1

# Comma-separated HTTPS image hosts returned by the backend (for example: cdn.example.com).
MEDIA_IMAGE_HOSTS=

# Per-feature live switches. "true" calls the API for that slice; anything else uses clearly
# labelled sample data or a non-submitting preview. Turn each on once its backend endpoints exist.
NEXT_PUBLIC_LIVE_AUTH=false
NEXT_PUBLIC_LIVE_MARKETPLACE=false
NEXT_PUBLIC_LIVE_CREATOR=false
# Also covers the buyer library (GET /entitlements).
NEXT_PUBLIC_LIVE_CHECKOUT=false
NEXT_PUBLIC_LIVE_GENERATION=false
