{
  "name": "@prompt-engine/api",
  "version": "0.1.0",
  "private": true,
  "description": "Prompt Engine shared backend: Express 5 API and background worker",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
