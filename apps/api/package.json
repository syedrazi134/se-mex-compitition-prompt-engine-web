    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@prompt-engine/shared-types": "0.1.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "mongoose": "9.11.4",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "rate-limiter-flexible": "11.2.3",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}
